# Copia este archivo como .env y llena tus llaves. Nunca subas .env a GitHub.

# OpenAI: el modelo de chat y los embeddings
OPENAI_API_KEY=sk-...

# Modelos (puedes cambiarlos sin tocar código)
MODELO_CHAT=openai:gpt-4.1-mini
MODELO_EMBEDDINGS=openai:text-embedding-3-small

# LangSmith: trazas y evals (el plan gratuito alcanza)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agente-soporte-correo
